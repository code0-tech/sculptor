EDITION=ce
NEXT_PUBLIC_EDITION=ce

SAGITTARIUS_GRAPHQL_URL=http://localhost:80/graphql
SAGITTARIUS_CABLE_URL=http://localhost:80/cable

PLAYGROUND_MOCK_DIR=#./mock
PLAYGROUND_FRAME_ANCESTORS=#"'self'"

# Directory the shipped flow templates are read from. Defaults to ./templates when unset.
# Additional templates can be mounted into that folder at runtime.
FLOW_TEMPLATES_DIR=./templates

SUBSCRIPTION_URL=https://codezero.build/licenses
CHECKOUT_URL=https://codezero.build/subscription

UPGRADE_VISIBILITY_DAYS=7
UPGRADE_DESCRIPTION="Unlock higher limits for executions and AI usage.\nPick the plan that fits. Pro, Max or fully custom."
UPGRADE_BENEFIT_ICON_1=bolt
UPGRADE_BENEFIT_TITLE_1=Up to 10k executions
UPGRADE_BENEFIT_TEXT_1=Run your flows without hitting the execution cap of this workspace.
UPGRADE_BENEFIT_ICON_2=sparkles
UPGRADE_BENEFIT_TITLE_2=Up to 4mio AI tokens
UPGRADE_BENEFIT_TEXT_2=Higher token limits for AI actions across the whole workspace.
UPGRADE_BENEFIT_ICON_3=adjustments
UPGRADE_BENEFIT_TITLE_3=Limits that fit you
UPGRADE_BENEFIT_TEXT_3=Scale executions and AI as you grow. Pro, Max or fully custom.
UPGRADE_BENEFIT_ICON_4=headset
UPGRADE_BENEFIT_TITLE_4=Priority support
UPGRADE_BENEFIT_TEXT_4=Get faster help from our team when it matters most.
UPGRADE_PRICE_LABEL=Full access starts at
UPGRADE_CTA_LABEL=Choose your plan
UPGRADE_DISCOUNT_CODE=HELLO20
UPGRADE_DISCOUNT_LABEL=20% off
UPGRADE_DISCOUNT_HINT=Once the timer runs out, this code is gone.
UPGRADE_BASE_PRICE=8.95
UPGRADE_DISCOUNTED_PRICE=7.16
UPGRADE_DISCOUNT_DURATION_MINUTES=30
UPGRADE_DISCOUNT_DELAY_SECONDS=1.5

NEXT_PUBLIC_SCULPTOR_VERSION=0.0.0
NEXT_PUBLIC_PICTOR_VERSION=1.0.0
NEXT_PUBLIC_ALLOWED_REDIRECT_DOMAINS=*.code0.tech,*.codezero.build

NEXT_PUBLIC_OTEL_SERVICE_NAME=#"sculptor-client"
NEXT_PUBLIC_OTEL_HEADER=#"Authorization: Basic <auth-token>"
NEXT_PUBLIC_OTEL_ENVIRONMENT=#"development"

OTEL_SERVICE_NAME=#"sculptor-server"
OTEL_HEADER=#"Authorization: Basic <auth-token>"

NEXT_PUBLIC_OTEL_LOGS_ENDPOINT=#"http://localhost:4318/v1/logs"
OTEL_LOGS_ENDPOINT=#"http://localhost:4318/v1/logs"

NEXT_PUBLIC_OTEL_TRACES_ENDPOINT=#"http://localhost:4318/v1/traces"
OTEL_TRACES_ENDPOINT=#"http://localhost:4318/v1/traces"

OTEL_METRICS_ENDPOINT=#"http://localhost:4318/v1/metrics"